# =====================================================================
#  Variables de entorno - Reto de Automatización Wompi
#  Copia este archivo como .env y reemplaza los valores con las llaves
#  sandbox entregadas para la prueba:   cp .env.example .env
#  El archivo .env está en .gitignore: NUNCA lo subas al repositorio.
#  Las variables del sistema operativo (p.ej. en CI) tienen prioridad
#  sobre las definidas en .env.
# =====================================================================

# ---------------------------- Obligatorias ----------------------------

# URL base del ambiente sandbox de Wompi (sin "/" al final)
WOMPI_BASE_URL=https://api-sandbox.co.uat.wompi.dev/v1

# Llave pública del comercio (sandbox). Se usa como Bearer para crear
# transacciones y para consultar /merchants/{llave} (acceptance tokens)
WOMPI_PUBLIC_KEY=pub_stagtest_...

# Llave privada del comercio (sandbox). Se usa en endpoints que requieren
# autenticación privada
WOMPI_PRIVATE_KEY=prv_stagtest_...

# Llave de integridad para generar la firma SHA-256 de cada transacción:
# SHA256(reference + amount_in_cents + currency + integrity_key)
WOMPI_INTEGRITY_KEY=stagtest_integrity_...

# ----------------------------- Opcionales -----------------------------

# Llave de eventos (webhooks). Sirve para validar el checksum de los eventos
# que Wompi envía al comercio. Los escenarios actuales no la usan; se deja
# documentada para futuras pruebas de webhooks
WOMPI_EVENTS_KEY=stagtest_events_...

# Tiempo máximo (segundos) para conectar con Wompi y recibir cada respuesta HTTP.
# Evita que la ejecución se quede colgada si hay problemas de red
# Valor por defecto: 30
WOMPI_HTTP_TIMEOUT_SECONDS=30

# Tiempo máximo (segundos) para esperar que una transacción salga de PENDING
# Valor por defecto: 30
WOMPI_POLLING_TIMEOUT_SECONDS=30

# Intervalo (milisegundos) entre consultas del estado de la transacción
# Valor por defecto: 2000
WOMPI_POLLING_INTERVAL_MILLIS=2000
